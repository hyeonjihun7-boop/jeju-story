# 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요. (VITE_ 가 붙은 값만 브라우저에 공개됩니다)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── 서버 전용 비밀 키 (VITE_ 금지!) ──
ANTHROPIC_API_KEY=       # AI 에이전트 (강사 제공 키)
DATA_GO_KR_KEY=          # 공공데이터포털 Decoding 키 — TourAPI(관광지·행사), 에어코리아(실측 대기질)
KAKAO_REST_KEY=          # 카카오 REST API 키 — 맛집 검색 + 옷·브랜드 사진(이미지 검색) + 블로그 후기
